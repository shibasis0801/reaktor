<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Android 13+ will not show a notification from an app that has not been granted this, and
        will not let the app ask without declaring it. It belongs here rather than in each app:
        this module is what posts notifications, and a module whose whole job is delivery should
        not depend on every consumer remembering to ask for permission to deliver.

        It arrived transitively from firebase-messaging until the FCM transport moved out to
        :reaktor-notification-fcm, at which point an app using only local reminders silently lost
        the ability to show any of them.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Scheduled local notifications are cleared on reboot unless they are re-armed. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <receiver
            android:name=".ReaktorNotificationAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".ReaktorNotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".ReaktorNotificationBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
