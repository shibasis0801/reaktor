{
    "name": "dev-shibasis-reaktor-security-karakum",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "bindings": "../../gradlew :reaktor-security:karakumBindings",
        "compile": "../../gradlew :reaktor-security:buildTypeScriptCompile"
    },
    "dependencies": {
        "reaktor-reaktor-security": "link:../build/dependeasy/kotlin/library"
    },
    "devDependencies": {
        "karakum": "1.0.0-alpha.112",
        "typescript": "6.0.3",
        "typescript-native": "npm:typescript@7.0.2"
    },
    "packageManager": "pnpm@12.10.1",
    "dependeasy": {
        "generatedScripts": [
            "bindings",
            "compile"
        ],
        "generatedLinks": {
            "dependencies": [
                "reaktor-reaktor-security"
            ]
        }
    }
}
