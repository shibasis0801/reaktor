+      keys.external_priv.data != HPKEPrivateKey::derive(suite, keys.external_secret).data) {
+    throw InvalidParameterError("Inconsistent snapshot transcript");
+  }
+  state._keys = keys.encryption_keys(tree_size);
+  return state;
+}
