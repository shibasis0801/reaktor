+      !state._tree_priv.private_key(NodeIndex(state._index)) ||
+      !state._tree_priv.consistent(state._tree) || !state.validate_tree()) {
+    throw InvalidParameterError("Inconsistent snapshot state");
+  }
+  const std::vector<std::pair<std::string, bytes>> derived{
+    {"sender data", keys.sender_data_secret}, {"encryption", keys.encryption_secret},
+    {"exporter", keys.exporter_secret}, {"authentication", keys.epoch_authenticator},
+    {"external", keys.external_secret}, {"confirm", keys.confirmation_key},
+    {"membership", keys.membership_key}, {"resumption", keys.resumption_psk},
+    {"init", keys.init_secret}};
+  if (keys.epoch_secret.size() != suite.secret_size() ||
