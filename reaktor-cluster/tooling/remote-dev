 if source.is_file():
  pending=state/(name+'.pending'); shutil.copy2(source,pending); pending.replace(state/name)
def skipped(relative):
 transient=relative.name.endswith('.lock') or relative.name.startswith(('tmp_','incoming-'))
 return relative.name in excluded or ('.git' in relative.parts and transient)
def clone(source,target):
 try:
  if source.is_symlink(): os.symlink(os.readlink(source),target)
  elif clonefile(os.fsencode(source),os.fsencode(target),0)!=0: shutil.copy2(source,target)
