slot=Path(sys.argv[1]); floor=int(sys.argv[2]); generated=set(sys.argv[3:]); removed=0
if slot.parent.name!='slots' or not slot.name.startswith('job-'): raise SystemExit('Not a worker job slot')
if slot.is_dir() and not (slot/'.remote-dev/gradle.lock').exists() and (floor<0 or shutil.disk_usage(slot).free<floor):
 for directory,dirs,files in os.walk(slot):
  for name in [*dirs]:
   path=Path(directory)/name
   if name in {'.git','.remote-dev'} or path.is_symlink(): dirs.remove(name)
   elif name in generated:
    dirs.remove(name); shutil.rmtree(path,ignore_errors=True); removed+=1
print(removed)
''', remote, str(-1 if floor is None else floor), *sorted(remote_retention.GENERATED), capture_output=True, text=True)
    return int(result.stdout)


def trim_idle_worker_slots():
    trimmed = {}
    for index in range(1, MAX_WORKER_SLOTS):
        with (STATE / (slot_lock_name(index) + '.lock')).open('a') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                trimmed[slot_lock_name(index)] = 'busy'
                continue
            try:
                trimmed[slot_lock_name(index)] = trim_worker_slot(slot_remote(index))
            except (subprocess.SubprocessError, OSError, ValueError) as error:
                trimmed[slot_lock_name(index)] = str(error)
    return trimmed


@contextlib.contextmanager
def worker_slot(index, publication=None, prepare=True):
    global REMOTE, LOCK_ROOT, SLOT, PUBLICATION
    previous = REMOTE, LOCK_ROOT, SLOT, PUBLICATION
    remote = slot_remote(index)
    REMOTE, LOCK_ROOT, SLOT, PUBLICATION = remote, remote + '/.remote-dev' if remote != BASE_REMOTE else None, index, publication
    try:
        if (index or WORKTREE is not None) and prepare:
            prepare_slot(remote)
        yield
    finally:
        REMOTE, LOCK_ROOT, SLOT, PUBLICATION = previous


def slot_build(name, relative, args, index, lock):
    remote_retention.require_admission(STATE)
    import workspace_storage
    workspace_storage.automatic(sys.modules[__name__], held_locks={slot_lock_name(index)})
    publication = 'changed-files' if worker_slot_count() > 1 else None
    with worker_slot(index, publication):
        return build(name, relative, args, worker_lock=lock)


@contextlib.contextmanager
def checkout_outputs():
    if ROOT == LOCAL_SLOTS / 'worker':
        yield
    else:
        import remote_build
        with remote_build.local_lease(STATE):
            yield


def git_repositories(base, relative=Path('.')):
    yield relative
    staged = subprocess.check_output(['git', '-C', str(base / relative), 'ls-files', '--stage', '-z'])
    for item in staged.split(b'\0'):
        if item and item.startswith(b'160000 '):
            path = relative / os.fsdecode(item.split(b'\t', 1)[1])
            if (base / path / '.git').exists():
                yield from git_repositories(base, path)


def source_excluded(path):
    parts = Path(path).parts
    return any(part in EXCLUDED and not (part == 'build' and parts[:index + 1] ==
               ('tests', 'reaktorDesktop', 'maestro', 'build')) for index, part in enumerate(parts))


def source_files(name):
    base = ROOT / name
    if (base / '.git').exists():
        names = set()
        for relative in git_repositories(base):
            data = subprocess.check_output(['git', '-C', str(base / relative), 'ls-files', '-z',
                                            '--cached', '--others', '--exclude-standard'])
            names.update(str(relative / os.fsdecode(p)) for p in data.split(b'\0') if p)
    else:
        names = set()
        for directory, dirs, files in os.walk(base):
            dirs[:] = [d for d in dirs if not source_excluded((Path(directory) / d).relative_to(base))]
            names.update(str((Path(directory) / f).relative_to(base)) for f in files)
    for special in ['config', 'local.properties', 'ecosystem/.state', '.env',
                    'tests/reaktorDesktop/maestro/build',
                    'tmp/dev-auth-fixtures.dev.json', 'tmp/dev-auth-fixtures.json']:
        path = base / special
        if path.is_file():
            names.add(special)
        elif path.is_dir():
            names.update(str(p.relative_to(base)) for p in path.rglob('*') if p.is_file())
    return sorted(p for p in names if p != '.reaktor/atlas-worker.json' and not source_excluded(p)
                  and ((base / p).is_file() or (base / p).is_symlink()))


def sync(names, frozen=False, transfer_files=None, checksum_files=None):
    # The supervisor's lease is host-wide even when its job directory is isolated.
    ssh(f'test ! -d {shlex.quote((LOCK_ROOT or CONFIG["remote_root"] + "/.remote-dev") + "/gradle.lock")} || '
        "{ echo 'A worker build is active; resume or wait for it before syncing sources.' >&2; exit 75; }")
    manifest_path = ROOT / 'source-manifest.json'
