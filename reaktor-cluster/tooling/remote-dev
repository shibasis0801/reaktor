    for name in names:
        base = ROOT / name
        target = f'{REMOTE}/{name}'
        # A materialized checkout has the committed index. Its frozen manifest
        # also owns staged submodules and files hidden by that older index.
        repositories = ([Path(repository).relative_to(name) for repository in frozen_manifest['repositories']
                         if repository == name or repository.startswith(name + '/')]
                        if frozen_manifest is not None else list(git_repositories(base)) if (base / '.git').exists() else [])
        for relative in repositories:
            local_repo = base / relative
            remote_repo = str(Path(target) / relative)
            local_head = subprocess.check_output(['git', '-C', str(local_repo), 'rev-parse', 'HEAD'], text=True).strip()
            ensure_repo = f'test -e {shlex.quote(remote_repo + "/.git")} || ' + shlex.join(['git', 'init', '--quiet', remote_repo])
            prepare_repo = shlex.join(['mkdir', '-p', target]) + ' && (' + ensure_repo + ')'
            remote_head = ssh(prepare_repo + ' && { ' +
                              shlex.join(['git', '-C', remote_repo, 'rev-parse', '--verify', 'HEAD']) + ' 2>/dev/null || true; }',
                              capture_output=True, text=True).stdout.strip()
            if local_head != remote_head:
                run(['git', '-C', local_repo, 'push', '--quiet', f'{HOST}:{remote_repo}',
                     '+HEAD:refs/remotes/source/current'])
                ssh(shlex.join(['git', '-C', remote_repo, 'reset', '--mixed', 'refs/remotes/source/current']),
                    stdout=subprocess.DEVNULL)
        files = (sorted(relative[len(name) + 1:] for relative in frozen_manifest['files'] if relative.startswith(name + '/'))
                 if frozen_manifest is not None else source_files(name))
        if not repositories:
            ssh(shlex.join(['mkdir', '-p', target]))
        selected = files if transfer_files is None else sorted(set(files).intersection(transfer_files[name]))
        print(f'Syncing {name}: {len(files)} source files, {len(selected)} transfer candidates', flush=True)
        checked = set(selected) if transfer_files is not None else set()
        if checksum_files is not None:
            checked.intersection_update(checksum_files[name])
        for option, candidates in [('-a', sorted(set(selected) - checked)), ('-ac', sorted(checked))]:
            if not candidates:
                continue
            with tempfile.NamedTemporaryFile() as manifest:
                manifest.write(b''.join(os.fsencode(p) + b'\0' for p in candidates))
                manifest.flush()
                run(['rsync', option, '--from0', f'--files-from={manifest.name}',
                     '--rsync-path=ulimit -n 8192; /usr/bin/rsync',
                     str(base) + '/', f'{HOST}:{target}/'])
        remote_python('''import json,sys,subprocess,os
