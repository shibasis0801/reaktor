def prune_artifact_snapshot(snapshot, files):
    declared = {Path(relative) for relative in files}
    declared.update(parent for path in tuple(declared) for parent in path.parents)
    for directory, dirs, names in os.walk(snapshot, topdown=False, followlinks=False):
        for entry in [Path(directory) / name for name in names + dirs]:
            if entry.relative_to(snapshot) not in declared:
                if entry.is_dir() and not entry.is_symlink():
                    shutil.rmtree(entry)
                else:
                    entry.unlink()


def reconcile_distributions(snapshot, project, files):
    declared = {Path(relative) for relative in files}
    markers = distribution_markers(snapshot)
    distributions = {path for path in declared if any(path.parts[-len(marker):] == marker for marker in markers)}
    for relative in sorted(distributions):
        source = snapshot / relative
        if source.is_symlink() or not source.is_dir() or not source.resolve().is_relative_to(snapshot.resolve()):
            raise OSError(f'Expected an owned distribution directory: {relative}')
        destination = project / relative
        if destination.is_symlink() or not destination.resolve().is_relative_to(project.resolve()):
            raise OSError(f'Cannot reconcile a linked distribution directory: {relative}')
        destination.mkdir(parents=True, exist_ok=True)
        run(['rsync', '-ac', '--delete', str(source) + '/', str(destination) + '/'])


def artifact_reference(name, run_id, family):
    snapshots = STATE / 'artifacts'
    for candidate in sorted(snapshots.iterdir(), reverse=True):
        reference = candidate / name
        receipt = STATE / 'logs' / (candidate.name + '.json')
        if candidate.name == run_id or candidate.is_symlink() or not reference.is_dir() or reference.is_symlink() or not receipt.is_file():
            continue
        if (candidate / '.payload-pruned.json').exists():
            continue
        try:
            result = json.loads(receipt.read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(result, dict):
            continue
        compatible = result.get('artifact_family', artifact_family(result.get('tasks', []))) in {'all', family}
        if compatible and result.get('exit_code') == 0 and result.get('finished') and not result.get('copy_error'):
            return reference
    return None


