def read_gradle_request(name, relative, args):
    prefix = '-Pdependeasy.gradleRequest='
    options = [argument[len(prefix):] for argument in args if argument.startswith(prefix)]
    if not options:
        return None
    if len(options) != 1:
        raise ValueError('Exactly one Gradle request is required')
    root = selected_gradle_directory(name, relative, args)
    owned = root / 'build/dependeasy/contracts/gradle/requests'
    file = Path(options[0])
    if not file.is_absolute(): file = root / file
    if file.parent != owned or file.resolve() != file or owned.resolve() != owned or not file.is_file():
        raise ValueError('Gradle request escapes its owner')
    if file.stat().st_size > 8 * 1024 * 1024:
        raise ValueError('Gradle request exceeds the contract limit')
    content = file.read_bytes()
    if file.name != hashlib.sha256(content).hexdigest() + '.json':
        raise ValueError('Gradle request content changed')
    request = json.loads(content)
    if request.get('schema') != 1: raise ValueError('Unsupported Gradle request')
    return root, file, request


def synchronize_gradle_request(name, relative, args):
    selected = read_gradle_request(name, relative, args)
    if selected is None: return None
    root, file, request = selected
    destination = str(file).replace(str(ROOT), REMOTE, 1)
    remote_python('''from pathlib import Path
import sys
path=Path(sys.argv[1]); owner=Path(sys.argv[2])
if not path.is_relative_to(owner) or path.resolve()!=path: raise ValueError('Gradle request escapes its owner')
path.parent.mkdir(parents=True,exist_ok=True);path.parent.chmod(0o700)
''', destination, str(root).replace(str(ROOT), REMOTE, 1), capture_output=True, text=True)
    run(['rsync', '-a', str(file), f'{HOST}:{shlex.quote(destination)}'])
    remote_python('''from pathlib import Path
import hashlib,sys
path=Path(sys.argv[1]); owner=Path(sys.argv[2])
if not path.is_relative_to(owner) or path.resolve()!=path or not path.is_file(): raise ValueError('Gradle request escapes its owner')
if path.name != hashlib.sha256(path.read_bytes()).hexdigest()+'.json': raise ValueError('Gradle request content changed')
path.chmod(0o600)
''', destination, str(root).replace(str(ROOT), REMOTE, 1), capture_output=True, text=True)
    if 'planBuildNode' in gradle_tasks(args): return []
    model_file = root / 'build/dependeasy/model.json'
    if model_file.stat().st_size > 8 * 1024 * 1024: raise ValueError('Build model exceeds the contract limit')
    model = json.loads(model_file.read_text())
    if model.get('schema') != 4: raise ValueError('Unsupported build model; run exportBuildModel to regenerate it')
    node = next(node for node in model['nodes'] if node['id'] == request['node'])
    invocation = node['invocation']
    if invocation.get('type') != 'dev.shibasis.dependeasy.model.Invocation.Gradle': raise ValueError('Build node has no Gradle invocation')
    own = next(build['name'] for build in model['builds'] if build['directory'] == '.')
    return [(task if node['id']['build'] == own else ':' + node['id']['build'] + task) for task in invocation['tasks']]


def selected_gradle_directory(name, relative, args):
    directory = ROOT / name / relative
    for index, arg in enumerate(args):
        if arg in {'-p', '--project-dir'}:
            directory = ROOT / name / relative / args[index + 1]
        elif arg.startswith('--project-dir=') or arg.startswith('-p='):
            directory = ROOT / name / relative / arg.partition('=')[2]
    return directory.resolve()


def gradle_tasks(args, task_options=None):
    valued_options = {'--init-script', '-I', '--project-dir', '-p',
                      '--include-build', '--gradle-user-home', '-g', '--max-workers',
                      '--console', '--warning-mode', '-x', '--exclude-task', '-P', '--project-prop',
                      '-D', '--system-prop', '--priority', '--project-cache-dir', '-c', '--settings-file',
                      '-b', '--build-file', '-F', '--dependency-verification', '-M',
                      '--write-verification-metadata', '--update-locks', '--configuration-cache-problems'}
    tasks = []
    skip_value = False
    for arg in args:
        if skip_value:
            skip_value = False
        elif arg in valued_options:
            skip_value = True
        elif not arg.startswith('-'):
            tasks.append(arg)
        elif arg.startswith('--') and tasks:
            options = (task_options or {}).get(':' + tasks[-1].lstrip(':'), [])
            skip_value = any(option['name'] == arg[2:] and option['type'] in {'String', 'Integer'} for option in options)
    return tasks



def declared_build_owners(directory, layout, workspace):
    if not layout:
        return {}
    if not isinstance(layout, dict) or layout.get('schema') != 2 or not isinstance(layout.get('builds'), dict):
        raise ValueError('Unsupported composite build layout')
    owners = {}
    for identity, location in layout['builds'].items():
        if not isinstance(identity, str) or not isinstance(location, str) or Path(location).is_absolute():
            raise ValueError('Invalid composite build location')
        source = Path(os.path.normpath(str(Path(directory) / location)))
        for project in PROJECTS:
            root = Path(workspace) / project
            if source == root or root in source.parents:
                owners[identity] = project
                break
    return owners


def composite_artifacts(receipt):
    name = receipt['project']
    owners = {name: name}
    families = {}
    declaration = remote_contract_python('''import sys
print(json.dumps(read_hosts_contract(sys.argv[1])))
''', receipt['remote_path'], capture_output=True, text=True).stdout
    layout = json.loads(declaration)
    owners.update(declared_build_owners(receipt['remote_path'], layout, REMOTE))
    if layout:
        declared = layout.get('taskFamilies', {})
        if not isinstance(declared, dict):
            raise ValueError('Invalid artifact family declarations')
        families = {task: family for task, family in declared.items()
                    if isinstance(task, str) and re.fullmatch(r':(?:[\w-]+:)*[\w-]+', task)
                    and isinstance(family, str) and family in {'web', 'jvm', 'android', 'apple', 'agent', 'verification', 'metadata'}}
    # Copy only owners whose tasks participated, including UP-TO-DATE tasks.
    participated = set(re.findall(r'^> Task :([^:\s]+):', Path(receipt['log']).read_text(), re.MULTILINE))
    projects = dict.fromkeys([name, *(owners[identity] for identity in sorted(participated) if identity in owners)])
    return owners, projects, families, layout.get('taskOptions', {})


def artifact_family(args, declared=None, task_options=None):
    tasks = [':' + task.lstrip(':') for task in gradle_tasks(args, task_options)]
    declared = declared or {}
    if not tasks or any(task not in declared for task in tasks):
        return 'all'
    families = {declared[task] for task in tasks}
    effective = families - {'metadata'}
    return effective.pop() if len(effective) == 1 else 'metadata' if not effective else 'all'


def pull_xcode_resources(receipt, publish=True):
    paths = receipt.get('xcode_resources')
    if not paths:
        return []
    present = remote_python('from pathlib import Path; import sys; print(Path(sys.argv[1]).is_dir())',
                            paths['worker_path'], capture_output=True, text=True).stdout.strip()
    if present != 'True':
        return []
    snapshot = STATE / 'artifacts' / receipt['run_id'] / 'xcode-resources' / receipt['project']
    snapshot.mkdir(parents=True, exist_ok=True)
    local = Path(paths['local_path'])
    # Mirror only the generated Compose bundle, never the app executable or signing files.
    run(['rsync', '-ac', '--delete', f'{HOST}:{shlex.quote(paths["worker_path"] + "/")}', str(snapshot) + '/'])
    if publish:
        with checkout_outputs():
            local.mkdir(parents=True, exist_ok=True)
            run(['rsync', '-ac', '--delete', str(snapshot) + '/', str(local) + '/'])
    print(f'{"Copied" if publish else "Collected"} Compose resources for {receipt["project"]}', flush=True)
    return [str(local)]


def publish_build(receipt, worker_lock=None):
    run_id = receipt['run_id']
    path = STATE / 'logs' / (run_id + '.json')
    if receipt.get('cancelled'):
        return 130
    receipt.update(phase='Publishing', phase_host='local')
    build_control.write_json(path, receipt)
    if worker_lock is not None:
        fcntl.flock(worker_lock, fcntl.LOCK_UN)
    started = time.monotonic()
    output_lease = checkout_outputs() if any(files for _, files in receipt['pending_publications']) or receipt.get('pending_xcode') else contextlib.nullcontext()
    try:
        with output_lease:
            receipt['publication_queue_seconds'] = time.monotonic() - started
            for project, files in receipt['pending_publications']:
                if receipt.get('publication') == 'changed-files':
                    review = receipt.get('unverified_outputs', {}).get(project, ())
                    withheld = publish_artifacts(project, run_id, files, receipt['exit_code'] == 0, receipt['source_epoch'], review)
                    if withheld:
                        receipt.setdefault('withheld_outputs', {})[project] = len(withheld)
                    copied = {relative for relative in review if not relative.endswith('/')} - set(withheld)
                    if copied:
                        receipt.setdefault('unverified_copies', {})[project] = len(copied)
                else:
                    publish_artifacts(project, run_id, files, receipt['exit_code'] == 0)
            if receipt.get('pending_xcode'):
                local = Path(receipt['xcode_resources']['local_path'])
                local.mkdir(parents=True, exist_ok=True)
                snapshot = STATE / 'artifacts' / run_id / 'xcode-resources' / receipt['project']
                run(['rsync', '-ac', '--delete', str(snapshot) + '/', str(local) + '/'])
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        receipt.update(copy_error=str(error), exit_code=receipt['exit_code'] or 74)
        path.write_text(json.dumps(receipt, indent=2) + '\n')
        return receipt['exit_code']
    receipt.pop('pending_publications')
    receipt.pop('pending_xcode', None)
    receipt.pop('unverified_outputs', None)
    receipt['finished'] = datetime.datetime.now().isoformat()
    receipt.update(phase='Finished', phase_host='local')
    receipt['publication_seconds'] = time.monotonic() - started
    path.write_text(json.dumps(receipt, indent=2) + '\n')
    print(f'{receipt["project"]}: exit {receipt["exit_code"]}; receipt {path}', flush=True)
    return receipt['exit_code']


