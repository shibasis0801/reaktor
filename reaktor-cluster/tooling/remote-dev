def isolated_verification(args, contract):
    # Accept only declared verification tasks and options that can't change their workspace or effects.
    allowed = {'--', '--console=plain', '--stacktrace', '--info', '--rerun-tasks', '--no-daemon'}
    tasks = []
    filter_expected = False
    for arg in args:
        if filter_expected:
            if not re.fullmatch(r'[\w.*$-]+', arg):
                return False
            filter_expected = False
        elif arg == '--tests' and tasks:
            filter_expected = True
        elif arg in allowed:
            continue
        elif re.fullmatch(r':?[\w-]+(?::[\w-]+)*', arg):
            tasks.append(':' + arg.lstrip(':'))
        else:
            return False
    return bool(tasks) and not filter_expected and all(
        contract.get('taskFamilies', {}).get(task) == 'verification'
        and contract.get('taskHosts', {}).get(task, {}).get('execution') in {None, 'Any'}
        for task in tasks
    )


def additional_local_gradle(name, relative, args, reason):
    import remote_build
    global ROOT
    if local_slot_count() < 2:
        return None
    with (STATE / 'local-slot-1.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return None
        if local_slot_count() < 2:  # Respect a removal that raced with the lease.
            return None
        remote_retention.require_admission(STATE)
        helper = sys.modules[__name__]
        try:
            remote_build.disk_admission(helper, 'local')
            if (LOCAL_SLOTS / 'local-1').is_symlink():
                raise ValueError('The additional local workspace is a symbolic link')
            snapshot = remote_build.freeze(helper)
            slot = remote_build.materialize(helper, snapshot, 'local-1')
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            print(f'Additional local lane could not prepare an isolated workspace: {error}', flush=True)
            return None
        if LINE is not None:
            LINE.unlink(missing_ok=True)
        print(f'Building {name} on this Mac in lane 2: {reason}; workspace {slot}', flush=True)
        original_root = ROOT
        try:
            ROOT = slot
            code = local_gradle(name, relative, args, local_slot=1)
            artifacts = STATE / 'artifacts' / LAST_RUN_ID
            if code != 130:
                remote_build.collect_local(helper, slot, artifacts, code == 0, 'verification', projects=[name])
            if artifacts.is_dir():
                print(f'Verification artifacts: {artifacts}', flush=True)
            return code
        finally:
            ROOT = original_root


def route_gradle(name, relative, args):
    contract = read_hosts_contract(selected_gradle_directory(name, relative, args))
    tasks = {':' + task.lstrip(':') for task in gradle_tasks(args, contract.get('taskOptions', {}))}
    selected = read_gradle_request(name, relative, args)
    if selected is not None:
        root, _, request = selected
        node = request['node']
        owner = node['build']
        owner_directory = root / contract.get('builds', {}).get(owner, '.')
        owner_contract = read_hosts_contract(owner_directory)
        if owner_contract:
            contract = owner_contract
            tasks = {node['project'].rstrip(':') + ':' + node['name']}
    local_declared = any(contract.get('taskHosts', {}).get(task, {}).get('execution') == 'Local' for task in tasks)
    if local_declared:
        import remote_build
        with remote_build.local_lease(STATE, ticket=LINE) as lease:
            print('Declared local work owns the local host lease', flush=True)
            remote_retention.require_admission(STATE)
            return local_gradle(name, relative, args, on_line=released_after_launch(lease, tasks))
    available, reason = local_capacity()
    if LINE is not None:
        import remote_build
        remote_build.stand_aside(LINE, not available)
        if available and not remote_build.first_in_line(LINE):
            available, reason = False, 'a build that asked earlier is waiting for this Mac'
    primary_busy = False
    with (STATE / 'local-gradle.lock').open('a') as lock:
        if available:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                primary_busy = True
            else:
                if LINE is not None:
                    LINE.unlink(missing_ok=True)
                print(f'Building {name} on this Mac: {reason}', flush=True)
                remote_retention.require_admission(STATE)
                return local_gradle(name, relative, args)
    if primary_busy:
        if selected is None and os.environ.get('REMOTE_DEV_CACHE') != 'write' and isolated_verification(args, contract):
            result = additional_local_gradle(name, relative, args, reason)
            if result is not None:
                return result
        reason = 'no eligible local build lane is available'
    print(f'Routing to {HOST}: {reason}', flush=True)
    return None


def scheduled_gradle(name, relative, args):
    remote_retention.require_admission(STATE)
    import mobile_worker
    if mobile_worker.requested(sys.modules[__name__], name, relative, args):
        return mobile_worker.gradle(sys.modules[__name__], name, relative, args)
    return queued_worker_gradle(name, relative, args, lambda: route_gradle(name, relative, args))


def worker_unreachable_limit():
    return int(os.environ.get('REMOTE_DEV_WORKER_UNREACHABLE_SECONDS') or CONFIG.get('worker_unreachable_seconds', 600))


def unreachable_worker(reason, since):
    if 'worker capacity unavailable' not in reason:
        return None
    if 'Operation not permitted' in reason:
        return (f'remote-dev: this process may not connect to {HOST} ({reason}). It is probably running in a sandbox: '
                'run it outside the sandbox, or run checks with the reaktor MCP check_run.')
    if time.monotonic() - since > worker_unreachable_limit():
        return (f'remote-dev: {HOST} has been unreachable for {worker_unreachable_limit() // 60} minutes ({reason}). '
                f'Check the link to {HOST}, or run checks with the reaktor MCP check_run.')
    return None


def queued_worker_gradle(name, relative, args, local=lambda: None):
    global LINE
    import remote_build
    waiting = None
    unreachable_since = None
    with remote_build.place_in_line(STATE) as ticket:
        LINE = ticket
        try:
            while True:
                result = local()
                if result is not None:
                    return result
                claimed, reason = claim_worker_slot()
                if claimed is not None:
                    LINE = None
                    ticket.unlink(missing_ok=True)
                    index, lock = claimed
                    with lock:
                        return slot_build(name, relative, args, index, lock)
                if 'worker capacity unavailable' in reason:
                    if unreachable_since is None:
                        unreachable_since = time.monotonic()
                    gave_up = unreachable_worker(reason, unreachable_since)
                    if gave_up:
                        raise SystemExit(gave_up)
                else:
                    unreachable_since = None
                if reason.partition(':')[0] != waiting:
                    print(reason, flush=True)
                    waiting = reason.partition(':')[0]
                time.sleep(5)
        finally:
            LINE = None


def worker_slot_count():
    count = int(os.environ.get('REMOTE_DEV_WORKER_SLOTS') or json.loads((STATE / 'config.json').read_text()).get('worker_slots', 2))
    if not 1 <= count <= MAX_WORKER_SLOTS:
        raise ValueError(f'worker_slots must be between 1 and {MAX_WORKER_SLOTS}')
    return count


def slot_lock_name(index):
    return 'worker-gradle' if index == 0 else f'worker-slot-{index}'


def slot_remote(index):
    if WORKTREE is not None:
        return f'{BASE_REMOTE}/.remote-dev/agent-worktrees/{WORKTREE}/slots/job-{index}'
    return BASE_REMOTE if index == 0 else f'{BASE_REMOTE}/.remote-dev/slots/job-{index}'


def worker_disk_floor():
    return int(CONFIG.get('worker_slot_min_free_disk_gib', 20)) * 1024 ** 3


def claim_worker_slot():
    remote_retention.require_admission(STATE)
    reason = 'Both build hosts are occupied; checking again as capacity becomes available'
    for index in range(worker_slot_count()):
        lock = (STATE / (slot_lock_name(index) + '.lock')).open('a')
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            lock.close()
            continue
        admitted, observed = worker_admission(index)
        if not admitted:
            lock.close()
            reason = f'Worker slot {index} is waiting: {observed}'
            continue
        if index:
            print(f'Running in worker slot {index} beside another worker job: {observed}', flush=True)
        return (index, lock), None
    return None, reason


def worker_admission(index):
    memory_floor = int(CONFIG.get('worker_slot_min_free_memory_percent', 40))
    try:
        result = remote_python('''import re,shutil,subprocess,sys
from pathlib import Path
memory=subprocess.run(['/usr/bin/memory_pressure'],capture_output=True,text=True,check=True,timeout=10).stdout
print(re.search(r'System-wide memory free percentage: (\\d+)%',memory)[1],shutil.disk_usage(sys.argv[1]).free,int(Path(sys.argv[2]).is_dir()))
''', BASE_REMOTE, slot_remote(index) + '/.remote-dev/gradle.lock', capture_output=True, text=True, timeout=30)
        memory, disk, busy = map(int, result.stdout.split())
    except (subprocess.SubprocessError, OSError, ValueError) as error:
        said = (getattr(error, 'stderr', None) or '').strip().splitlines()
        return False, f'worker capacity unavailable ({said[-1] if said else error})'
    observed = f'{memory}% worker memory free, {disk // 1024 ** 3} GiB worker disk free'
    if busy:
        return False, 'an unfinished job still holds this slot; resume it or wait for it'
    if index == 0:
        return True, observed
    if memory < memory_floor:
        return False, f'{observed}; another job needs {memory_floor}% memory free'
    if disk < worker_disk_floor():
        return False, f'{observed}; another job needs {worker_disk_floor() // 1024 ** 3} GiB disk free'
    return True, observed


def prepare_slot(remote):
    remote_python('''import ctypes,json,os,shutil,subprocess,sys
