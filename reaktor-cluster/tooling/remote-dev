def run(argv, **kwargs):
    return subprocess.run([str(a) for a in argv], check=True, **kwargs)


def ssh(command, **kwargs):
    if 'input' not in kwargs:
        kwargs.setdefault('stdin', subprocess.DEVNULL)
    return run(['ssh', '-o', 'BatchMode=yes', HOST, command], **kwargs)


def remote_python(code, *args, **kwargs):
    if 'input' in kwargs:
        return ssh(shlex.join(['/opt/homebrew/bin/python3', '-c', code, *args]), **kwargs)
    program = f'import sys\nsys.argv = {["-", *args]!r}\nexec(compile({code!r}, "<remote-dev>", "exec"))'
    kwargs['input'] = program if kwargs.get('text') else program.encode()
    return ssh(shlex.join(['/opt/homebrew/bin/python3', '-']), **kwargs)


def remote_contract_python(code, *args, **kwargs):
    source = Path(__file__).with_name('hosts_contract.py').read_text()
    return remote_python(source + '\n' + code, *args, **kwargs)


def project_at(path, worktrees=True):
    global ROOT, PROJECTS, WORKTREE
    path = Path(path).resolve()
    for name in PROJECTS:
        base = (ROOT / name).resolve()
        if path == base or base in path.parents:
            return name, path.relative_to(base)
    if worktrees and WORKTREE is None:
        import workspace_storage
        for identity, roots in workspace_storage.registered_worktrees(ROOT, STATE):
            for source, checkout in roots:
                if path == checkout or checkout in path.parents:
                    ROOT, PROJECTS, WORKTREE = checkout.parent, [base.name for base, _ in roots], identity
                    return source.name, path.relative_to(checkout)
    raise SystemExit(f'Not one of the configured projects: {path}')


def local_capacity():
    try:
        cpu = subprocess.run(['/usr/bin/top', '-l', '2', '-s', '1', '-n', '0'],
                             capture_output=True, text=True, check=True, timeout=5).stdout
        memory = subprocess.run(['/usr/bin/memory_pressure', '-Q'], capture_output=True,
                                text=True, check=True, timeout=5).stdout
        statistics = subprocess.run(['/usr/bin/vm_stat'], capture_output=True,
                                    text=True, check=True, timeout=5).stdout
        system = subprocess.run(['/usr/sbin/sysctl', 'hw.memsize', 'kern.memorystatus_vm_pressure_level', 'vm.swapusage'],
                                capture_output=True, text=True, check=True, timeout=5).stdout
        idle = float(re.findall(r'([\d.]+)% idle', cpu)[-1])
        free = int(re.search(r'System-wide memory free percentage: (\d+)%', memory)[1])
        total = int(re.search(r'hw.memsize: (\d+)', system)[1])
        pressure = int(re.search(r'kern.memorystatus_vm_pressure_level: (\d+)', system)[1])
        page_size = int(re.search(r'page size of (\d+) bytes', statistics)[1])
        compressed = int(re.search(r'Pages occupied by compressor:\s+(\d+)', statistics)[1]) * page_size
        swap = re.search(r'used = ([\d.]+)([MG])', system)
        swapped = float(swap[1]) * (1024 ** 3 if swap[2] == 'G' else 1024 ** 2)
        reason = (f'{idle:.0f}% CPU idle, {free}% memory capacity, pressure {pressure}, '
                  f'{compressed / total:.0%} compressed, {swapped / 1024 ** 3:.1f} GiB swap')
        return (idle >= CONFIG.get('local_min_idle_percent', 60) and free >= CONFIG.get('local_min_free_percent', 40)
                and pressure == 1 and compressed <= total * CONFIG.get('local_max_compressed_fraction', 0.15)
                and swapped <= CONFIG.get('local_max_swap_gib', 1) * 1024 ** 3), reason
    except (subprocess.SubprocessError, ValueError, IndexError, TypeError, OSError):
        return False, 'local capacity unavailable'


def declared_gradle_runtime(name, relative, args):
    directory = selected_gradle_directory(name, relative, args)
    workspace = ROOT.resolve()
    while directory == workspace or workspace in directory.parents:
        if directory == (ROOT / name).resolve() or any((directory / file).is_file() for file in ('settings.gradle.kts', 'settings.gradle')):
            return (directory / 'gradle/gradle-daemon-jvm.properties').is_file()
        directory = directory.parent
    return False


def local_gradle(name, relative, args, log=None, on_line=None, local_slot=0):
    import workspace_storage
    global LAST_RUN_ID
    workspace_storage.automatic(sys.modules[__name__], held_locks={'local-slot-1' if local_slot else 'local-gradle'})
    if args[:1] == ['--']:
        args = args[1:]
    workers = CONFIG.get('local_max_workers', 6)
    if local_slot:
        workers = min(workers, 4)
    idle_timeout = 60_000 if local_slot else 300_000
    defaults = ['--console=plain', f'--max-workers={workers}', f'-Dorg.gradle.daemon.idletimeout={idle_timeout}',
                *([] if not local_slot and CONFIG.get('local_watch_fs', True) else ['--no-watch-fs'])]
    supplied_options = {arg.partition('=')[0] for arg in args}
    if declared_gradle_runtime(name, relative, args):
        defaults.append('-Dorg.gradle.java.home=' + CONFIG['java_home'])
    else:
        defaults.extend(['-Dorg.gradle.jvmargs=-Xmx6g -XX:MaxMetaspaceSize=2g', '-Pkotlin.daemon.jvmargs=-Xmx4g'])
    defaults = [arg for arg in defaults if arg.partition('=')[0] not in supplied_options]
    directory = ROOT / name / relative
    wrapper = directory / 'gradlew'
    if not wrapper.exists(): wrapper = ROOT / name / 'gradlew'
    run_id = datetime.datetime.now().strftime('%Y%m%d-%H%M%S') + '-' + uuid.uuid4().hex[:8] + '-' + name
    LAST_RUN_ID = run_id
    log = log or STATE / 'logs' / (run_id + '.log')
    log.parent.mkdir(parents=True, exist_ok=True)
    command = [str(wrapper), *defaults, '--init-script',
               str(Path(__file__).resolve().parent / 'physical-devices.gradle'), *args]
    env = dict(os.environ, REMOTE_DEV_WORKER='1', CMAKE_BUILD_PARALLEL_LEVEL=str(workers if local_slot else 6))
    env.update(cache_environment())
    if env.get('REMOTE_DEV_CACHE_URL'):
        command += ['--init-script', str(Path(__file__).resolve().parent / 'build-cache.gradle')]
    execution_id = uuid.uuid4().hex
    job = STATE / 'jobs' / run_id
    control = build_control.prepare(job, run_id, execution_id, ['/usr/bin/time', '-l', *command], directory)
    control['host'] = 'local'
    receipt = {'run_id': run_id, 'project': name, 'worker': 'local', 'local_slot': local_slot, 'tasks': args, 'workspace_root': str(ROOT),
               'started': datetime.datetime.now().isoformat(), 'log': str(log),
               'queue_seconds': time.monotonic() - QUEUED_AT, 'exit_code': None,
               'owner': workspace_storage.run_owner(), 'execution_control': control,
               'project_directory': str(directory.resolve()), 'phase': 'Executing', 'phase_host': 'local'}
    receipt['resourceScope'] = 'time -l covers the wrapper/client process; detached Gradle/Kotlin daemons are excluded'
    receipt_path = STATE / 'logs' / (run_id + '.json')
    receipt_path.parent.mkdir(parents=True, exist_ok=True)
    build_control.write_json(receipt_path, receipt)
    started = time.monotonic()
    code = 130
    try:
        with log.open('w') as output:
            process = subprocess.Popen([sys.executable, str(Path(build_control.__file__).resolve()), '_supervise', str(job)], cwd=directory, env=env,
                                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)
            try:
                for line in process.stdout:
                    line = re.sub(r'\b(?:gh[pousr]_[A-Za-z0-9_]+|github_pat_[A-Za-z0-9_]+)', '[REDACTED]', line)
                    output.write(line); output.flush()
                    print(line, end='', flush=True)
                    if on_line: on_line(line)
                code = process.wait()
            finally:
                if process.poll() is None:
                    process.send_signal(signal.SIGTERM)
                    try: process.wait(timeout=12)
                    except subprocess.TimeoutExpired:
                        print('Owned supervisor has not confirmed shutdown; execution state remains inspectable.', file=sys.stderr)
                process.stdout.close()
    finally:
        execution = build_control.state(job, execution_id)
        if execution.get('status') in build_control.TERMINAL:
            receipt.update(exit_code=execution['exitCode'], execution_seconds=time.monotonic() - started,
                           finished=execution['finished'], phase='Finished')
            if execution['status'] == 'Cancelled':
                receipt['cancelled'] = True
            build_control.write_json(receipt_path, receipt)
    return code


def cache_environment():
    mode = os.environ.get('REMOTE_DEV_CACHE', 'off')
    if mode == 'off': return {}
    if mode not in {'read', 'write'}: raise ValueError('REMOTE_DEV_CACHE must be off, read or write')
    if mode == 'write' and ROOT not in {LOCAL_SLOTS / 'local', LOCAL_SLOTS / 'worker'}:
        raise ValueError('Cache writes require a verified isolated snapshot build')
    configuration = json.loads((STATE / 'build-cache/client.json').read_text())
    account = configuration['writer' if mode == 'write' else 'reader']
    policy = {'REMOTE_DEV_CACHE_URL': configuration['url'], 'REMOTE_DEV_CACHE_USER': account['username'],
              'REMOTE_DEV_CACHE_PASSWORD': account['password'], 'REMOTE_DEV_CACHE_PUSH': str(mode == 'write').lower()}
    if os.environ.get('REMOTE_DEV_CACHE_LOCAL') == 'false': policy['REMOTE_DEV_CACHE_LOCAL'] = 'false'
    return policy


DESKTOP_LAUNCHES = Path.home() / '.reaktor' / 'desktop-runtime' / 'launches'


def released_after_launch(lease, tasks):
    if not tasks or any(task.rpartition(':')[2] != 'run' for task in tasks):
        return None
    launches = DESKTOP_LAUNCHES
    known = set(launches.glob('*.classpath'))
    started = {'> Task ' + task for task in tasks}

    def release():
        while not lease.closed:
            if set(launches.glob('*.classpath')) - known:
                try:
                    fcntl.flock(lease, fcntl.LOCK_UN)
                except (OSError, ValueError):
                    return
                print('The app runs from its own copy of its jars, so the local build lease is free for other builds', flush=True)
                return
            time.sleep(0.5)

    def watch(line):
        if line.strip() in started:
            threading.Thread(target=release, daemon=True).start()
    return watch


