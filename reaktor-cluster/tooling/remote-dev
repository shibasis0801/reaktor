def distribution_markers(project):
    policy = read_hosts_contract(project)
    if not policy:
        return DISTRIBUTIONS
    paths = policy.get('distributionDirectories', [])
    if not isinstance(paths, list):
        raise ValueError('Invalid distribution declarations')
    markers = []
    for location in paths:
        path = Path(location) if isinstance(location, str) else None
        if path is None or path.is_absolute() or '..' in path.parts or 'build' not in path.parts or not (project / path).resolve().is_relative_to(project.resolve()):
            raise ValueError('Distribution is not an owned build output')
        markers.append(path.parts)
    return (*DISTRIBUTIONS, *markers, *(path.parts for path in bundle_directories(project, policy)))


def distribution_root(relative, markers=DISTRIBUTIONS):
    parts = Path(relative).parts
    return next((Path(*parts[:index + len(marker)]) for index in range(len(parts)) for marker in markers
                 if parts[index:index + len(marker)] == tuple(marker)), None)


def worker_outputs(name, listing):
    local = ROOT / name
    stale = set(listing['stale'])
    selected, unverified = [], []
    for relative in listing['found']:
        unit = distribution_root(relative, listing.get('distributions', DISTRIBUTIONS))
        if unit is None and relative.endswith('/'):
            continue
        if relative in stale:
            if os.path.lexists(local / (unit or relative)) or '/build/classes/' in '/' + relative:
                continue
            unverified.append(relative)
        selected.append(relative)
    return selected, unverified


def publication_ledger():
    ledger = sqlite3.connect(STATE / 'publications.sqlite3', timeout=60)
    ledger.execute('create table if not exists publications (project text not null, path text not null, '
                   'source_epoch real not null, run_id text not null, primary key (project, path))')
    with contextlib.suppress(sqlite3.OperationalError):
        ledger.execute('alter table publications add column published real')
    return ledger


def withheld_outputs(name, files, synced, unverified, markers=DISTRIBUTIONS):
    local = ROOT / name
    with contextlib.closing(publication_ledger()) as ledger:
        published = {path: (epoch, at) for path, epoch, at in ledger.execute(
            'select path, source_epoch, published from publications where project = ?', (f'{WORKTREE}:{name}' if WORKTREE else name,))}
    def newer(relative):
        epoch, at = published.get(relative, (0.0, None))
        try:
            changed = os.lstat(local / relative).st_ctime
        except FileNotFoundError:
            return epoch > synced
        return epoch > synced or changed > synced and (at is None or changed > at)
    withheld = {relative for relative in files if not relative.endswith('/') and newer(relative)
                or relative in unverified and os.path.lexists(local / relative)}
    units = {distribution_root(relative, markers) for relative in withheld} - {None}
    for unit in {distribution_root(relative, markers) for relative in files} - {None} - units:
        if newer(str(unit)) or any(newer(str((Path(directory) / entry).relative_to(local)))
                                  for directory, dirs, names in os.walk(local / unit, followlinks=False)
                                  for entry in dirs + names):
            units.add(unit)
    return [relative for relative in files if relative in withheld or distribution_root(relative, markers) in units]


def record_publications(name, run_id, files, synced, unverified):
    now = time.time()
    rows = [(f'{WORKTREE}:{name}' if WORKTREE else name, relative, 0.0 if relative in unverified else synced, run_id, now)
            for relative in files if not relative.endswith('/')]
    with contextlib.closing(publication_ledger()) as ledger, ledger:
        ledger.executemany('insert into publications (project, path, source_epoch, run_id, published) values (?, ?, ?, ?, ?) '
                           'on conflict (project, path) do update set source_epoch = excluded.source_epoch, '
                           'run_id = excluded.run_id, published = excluded.published', rows)


def publish_artifacts(name, run_id, files, successful, synced=None, unverified=()):
    if not files:
        return []
    dest = STATE / 'artifacts' / run_id / name
    withheld = [] if synced is None else withheld_outputs(name, files, synced, set(unverified), distribution_markers(dest))
    held = set(withheld)
    published = [relative for relative in files if relative not in held]
    for relative in published:
        artifact = dest / relative
        local = ROOT / name / relative
        if artifact.name == 'node_modules' and artifact.is_symlink() and not local.is_symlink():
            if local.is_dir():
