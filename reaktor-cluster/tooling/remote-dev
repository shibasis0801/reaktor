    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        copy_error = str(error)
        if code == 0:
            code = 74
    receipt.update({'collected': datetime.datetime.now().isoformat(), 'exit_code': code,
                    'copied_files': len(copied), 'copy_error': copy_error,
                    'collection_seconds': time.monotonic() - collection_started,
                    'pending_publications': publications, 'pending_xcode': bool(xcode)})
    if unverified:
        receipt['unverified_outputs'] = unverified
    if SLOT or WORKTREE is not None:
        try:
            receipt['worker_slot_trimmed'] = trim_worker_slot(REMOTE, worker_disk_floor())
        except (subprocess.SubprocessError, OSError, ValueError) as error:
            receipt['worker_slot_trim_error'] = str(error)
    (STATE / 'logs' / (run_id + '.json')).write_text(json.dumps(receipt, indent=2) + '\n')
    return publish_build(receipt, worker_lock)


def ports():
    ids = subprocess.check_output(['docker', '--context', 'm1-worker', 'ps', '-q'], text=True).split()
    items = json.loads(subprocess.check_output(['docker', '--context', 'm1-worker', 'inspect', *ids])) if ids else []
    numbers = sorted({int(binding['HostPort']) for item in items
                      for target, bindings in (item['HostConfig']['PortBindings'] or {}).items()
                      if target.endswith('/tcp') for binding in (bindings or []) if binding.get('HostPort')})
    args = ['/usr/bin/ssh', '-N', '-o', 'BatchMode=yes', '-o', 'ControlMaster=no', '-o', 'ControlPath=none',
            '-o', 'ExitOnForwardFailure=yes', '-o', 'ServerAliveInterval=15', '-o', 'ServerAliveCountMax=3']
    for number in numbers:
        args += ['-L', f'127.0.0.1:{number}:127.0.0.1:{number}']
    args += [HOST]
    agent = {'Label': 'dev.ovd.m1-worker-ports', 'ProgramArguments': args,
             'RunAtLoad': True, 'KeepAlive': True, 'ThrottleInterval': 15,
             'StandardOutPath': str(STATE / 'logs/port-forward.log'),
             'StandardErrorPath': str(STATE / 'logs/port-forward-error.log')}
    path = Path.home() / 'Library/LaunchAgents/dev.ovd.m1-worker-ports.plist'
    encoded = plistlib.dumps(agent)
    if path.exists() and path.read_bytes() == encoded:
        status = subprocess.run(['launchctl', 'print', f'gui/{os.getuid()}/dev.ovd.m1-worker-ports'],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if status.returncode == 0:
            return
    subprocess.run(['launchctl', 'bootout', f'gui/{os.getuid()}', str(path)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    path.parent.mkdir(exist_ok=True)
    path.write_bytes(encoded)
    (STATE / 'docker-forward-ports.json').write_text(json.dumps(numbers))
    if numbers:
        run(['launchctl', 'bootstrap', f'gui/{os.getuid()}', str(path)])
    print(f'Forwarded worker TCP ports: {numbers}', flush=True)


def _main():
    def terminated(signum, frame):
        raise KeyboardInterrupt(f'Terminated by signal {signum}')
    signal.signal(signal.SIGTERM, terminated)
    parser = argparse.ArgumentParser(description='Route Gradle builds by load and physical mobile work to the device host')
    commands = parser.add_subparsers(dest='command', required=True)
    mobile = commands.add_parser('mobile', help='Run flows, adb and iOS tools on the USB device worker')
    mobile.add_argument('args', nargs=argparse.REMAINDER)
    commands.add_parser('sync')
    commands.add_parser('status')
    commands.add_parser('ports')
    commands.add_parser('freeze', help='Capture source without executing Gradle')
    cleanup = commands.add_parser('cleanup', help='Enforce the remote and temporary storage budgets')
    cleanup.add_argument('--dry-run', action='store_true')
    cleanup.add_argument('--trim-slots', action='store_true', help='Discard idle isolated build and worker slot caches')
    cleanup.add_argument('--wait', action='store_true', help='Wait for active builds to finish before cleanup')
    isolated = commands.add_parser('snapshot-build', help='Run one serial host job against a retained snapshot')
    isolated.add_argument('--run-id')
    isolated.add_argument('snapshot')
    isolated.add_argument('host', choices=['local', 'worker'])
    isolated.add_argument('project', choices=PROJECTS)
    isolated.add_argument('tasks', nargs=argparse.REMAINDER)
    resume = commands.add_parser('resume')
    resume.add_argument('run_id')
    controls = commands.add_parser('job-control', help='Inspect or stop one verified supervised routed execution')
    controls.add_argument('action', choices=['inspect', 'stop', 'resume'])
    controls.add_argument('run_id')
    controls.add_argument('--execution')
    controls.add_argument('--state-root', type=Path)
    suite = commands.add_parser('suite')
    suite.add_argument('tasks', nargs=argparse.REMAINDER)
    for verb in ['build', 'pull']:
        sub = commands.add_parser(verb)
        sub.add_argument('project', choices=PROJECTS)
        sub.add_argument('tasks', nargs=argparse.REMAINDER)
    gradle = commands.add_parser('gradle')
    gradle.add_argument('--project-dir', required=True)
    gradle.add_argument('tasks', nargs=argparse.REMAINDER)
    docker = commands.add_parser('docker')
    docker.add_argument('args', nargs=argparse.REMAINDER)
    options = parser.parse_args()
    if options.command == 'job-control':
        try:
            result = build_control.execute(sys.modules[__name__], options.action, options.run_id, options.execution)
            print(json.dumps(result))
            return 0
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            print(json.dumps(build_control.failure(options.run_id, options.execution, error)))
            return 1
    inventory = options.command == "mobile" and options.args[:1] == ["inventory"]
    if options.command not in {"status", "ports"} and not inventory:
        remote_retention.require_admission(STATE)
    if options.command == 'mobile':
        import mobile_worker
        return mobile_worker.main(sys.modules[__name__], options.args)
    import workspace_storage
    if options.command == 'cleanup':
        payloads = remote_retention.cleanup(sys.modules[__name__], options.dry_run,
                                           options.trim_slots, wait=options.wait)
        if options.trim_slots and not options.dry_run:
            payloads['worker_slots'] = trim_idle_worker_slots()
        budgets = workspace_storage.cleanup(dry_run=options.dry_run, wait=options.wait)
        print(json.dumps({'payloads': payloads, 'budgets': budgets}, indent=2))
        return int(any(budgets.get(name, {}).get('within_limit') is False for name in ('remote', 'tmp')))
    if options.command in {'freeze', 'snapshot-build'}:
        import remote_build
        helper = sys.modules[__name__]
        with workspace_storage.snapshot_pin(STATE, getattr(options, 'snapshot', None)):
            workspace_storage.automatic(helper)
            with workspace_storage.graph_activity(STATE):
                if options.command == 'freeze':
                    print(remote_build.freeze(helper))
                    return 0
                tasks = options.tasks[1:] if options.tasks[:1] == ['--'] else options.tasks
                receipt = remote_build.isolated_build(helper, options.snapshot, options.host, options.project, tasks, options.run_id)
                return receipt['exit_code']
    if options.command == 'status':
        ssh('hostname; /usr/libexec/java_home -V; df -h /System/Volumes/Data; /opt/homebrew/bin/docker ps')
        return 0
    if options.command == 'ports':
        ports()
        return 0
    if options.command == 'gradle':
        name, relative = project_at(options.project_dir)
        return scheduled_gradle(name, relative, options.tasks)
    import remote_build
    if options.command == 'build':
        import mobile_worker
        if mobile_worker.requested(sys.modules[__name__], options.project, Path('.'), options.tasks):
            return mobile_worker.gradle(sys.modules[__name__], options.project, Path('.'), options.tasks)
        return queued_worker_gradle(options.project, Path('.'), options.tasks or ['build'])
    if options.command == 'resume':
        receipt = json.loads((STATE / 'logs' / (options.run_id + '.json')).read_text())
        if receipt.get('workspace_root', str(ROOT)) != str(ROOT):
            project_at(Path(receipt['workspace_root']) / receipt['project'])
            if WORKTREE is None or receipt['workspace_root'] != str(ROOT):
                raise SystemExit('Isolated run recovery requires its original registered workspace')
        index = receipt.get('worker_slot') or 0
        if not remote_retention.receipt_root_matches(receipt, slot_remote(index)):
            raise SystemExit('The receipt names a worker folder outside its slot')
        with remote_build.lease(STATE / (slot_lock_name(index) + '.lock')) as worker_lock:
            receipt = workspace_storage.claim_run(STATE, options.run_id)
            workspace_storage.automatic(sys.modules[__name__], held_locks={slot_lock_name(index)})
            with worker_slot(index, receipt.get('publication'), prepare=False):
                return finish_build(receipt, worker_lock)
    with remote_build.lease(STATE / 'worker-gradle.lock') as worker_lock:
        if options.command in {'suite', 'pull'}:
            workspace_storage.automatic(sys.modules[__name__], held_locks={'worker-gradle'})
        if options.command == 'sync':
            sync(PROJECTS)
        elif options.command == 'suite':
            with worker_slot(0, 'changed-files' if worker_slot_count() > 1 else None):
                sync(PROJECTS)
                results = {}
                tasks = options.tasks[1:] if options.tasks[:1] == ['--'] else options.tasks
                for name in PROJECTS:
                    results[name] = build(name, Path('.'), tasks or ['build', '--continue'], False)
            (STATE / 'suite-results.json').write_text(json.dumps(results, indent=2) + '\n')
            return int(any(results.values()))
        elif options.command == 'pull':
            pull(options.project, datetime.datetime.now().strftime('%Y%m%d-%H%M%S') + '-pull')
        elif options.command == 'docker':
            name, relative = project_at(Path.cwd(), worktrees=False)
            with contextlib.redirect_stdout(sys.stderr):
                layout = read_hosts_contract(ROOT / name)
                owners = declared_build_owners(ROOT / name, layout, ROOT)
                sync(dict.fromkeys([name, *owners.values()]))
            docker_args = options.args[1:] if options.args[:1] == ['--'] else options.args
            args = [arg.replace(str(ROOT), REMOTE) for arg in docker_args]
            result = subprocess.run(['ssh', '-o', 'BatchMode=yes', HOST,
                                     f'cd {shlex.quote(f"{REMOTE}/{name}/{relative}")} && '
                                     + shlex.join(['/opt/homebrew/bin/docker', *args])])
            if result.returncode == 0:
                with contextlib.redirect_stdout(sys.stderr):
                    ports()
            return result.returncode
    return 0


def main():
    try:
        return _main()
    finally:
        mobile_work = sys.argv[1:2] == ['mobile'] and sys.argv[2:3] and sys.argv[2] in {'gradle', 'push'}
        if mobile_work or (sys.argv[1:2] and sys.argv[1] in {'gradle', 'build', 'suite', 'pull', 'resume',
                                                          'freeze', 'snapshot-build'}):
            import workspace_storage
            workspace_storage.automatic(sys.modules[__name__], strict=False)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
    except ValueError as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
