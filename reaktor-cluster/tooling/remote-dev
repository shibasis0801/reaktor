 if manifest.is_file(): shutil.copy2(manifest,state/(project+'.source.json'))
 pending.rename(target)
''', BASE_REMOTE, remote, json.dumps(sorted(EXCLUDED)), *PROJECTS)


def trim_worker_slot(remote, floor=None):
    import remote_retention
    if remote == BASE_REMOTE:
        raise ValueError('Only worker job slots are trimmed')
    result = remote_python('''import os,shutil,sys
