#!/usr/bin/env python3
import argparse
import os
import signal
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import remote_build
from cluster_locations import state_root, workspace_root

STATE = Path(os.environ.get('REMOTE_DEV_STATE', state_root(workspace_root(__file__))))


def routed_wrapper(command, state=STATE):
    if not (state / 'config.json').is_file():
        return False
    try:
        with Path(command[0]).open() as source:
            header = source.read(4096)
    except (OSError, UnicodeError):
        return False
    prefix = '''#!/bin/sh

if [ "${REMOTE_DEV_WORKER:-0}" != 1 ]; then
    cluster_project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    cluster_tooling="$cluster_project_dir/@tooling@"
    if [ ! -x "$cluster_tooling/remote-dev" ]; then
        cluster_tooling="$HOME/dev/reaktor/reaktor-cluster/tooling"
    fi
    if [ -x "$cluster_tooling/remote-dev" ] && python3 "$cluster_tooling/cluster_locations.py" configured; then
        exec "$cluster_tooling/remote-dev" gradle --project-dir "$cluster_project_dir" -- "$@"
    fi
fi
'''
    for relative in ('reaktor-cluster/tooling', '../reaktor/reaktor-cluster/tooling'):
        if not header.startswith(prefix.replace('@tooling@', relative)):
            continue
        project = Path(command[0]).resolve().parent
        tooling = project / relative
        if not os.access(tooling / 'remote-dev', os.X_OK):
            tooling = Path.home() / 'dev/reaktor/reaktor-cluster/tooling'
        if not os.access(tooling / 'remote-dev', os.X_OK) or not (tooling / 'cluster_locations.py').is_file():
            return None
        try:
            configured = subprocess.run([sys.executable, str(tooling / 'cluster_locations.py'), 'configured'],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            return None
        if configured.returncode == 0:
            return [str(tooling / 'remote-dev'), 'gradle', '--project-dir', str(project), '--'] + command[1:]
        return None
    return None

def main(argv):
    automatic = argv[:1] == ['--auto']
    project = Path.cwd().name
    tasks = []
    state = STATE
    if automatic:
        parser = argparse.ArgumentParser()
        parser.add_argument('--project', required=True)
        parser.add_argument('--task', action='append', default=[])
        parser.add_argument('--state-workspace', type=Path)
        if '--' not in argv:
            parser.error('The command must follow --')
        boundary = argv.index('--')
        options = parser.parse_args(argv[1:boundary])
        project, tasks = options.project, options.task
        if options.state_workspace is not None and 'REMOTE_DEV_STATE' not in os.environ:
            state = state_root(options.state_workspace)
        command = argv[boundary + 1:]
    else:
        command = argv[1:] if argv[:1] == ['--'] else argv
    if not command:
        print('usage: gradle-lease [--auto --project PROJECT --task TASK] -- COMMAND [ARGUMENT...]', file=sys.stderr)
        return 2
    routed = routed_wrapper(command, state) if automatic else None
    if routed:
        environment = dict(os.environ)
        environment.pop('REMOTE_DEV_WORKER', None)
        os.execvpe(routed[0], routed, environment)
    child = None

    def forward(signum, frame):
        if child is not None and child.poll() is None:
            child.send_signal(signum)
        else:
            raise SystemExit(128 + signum)

    signal.signal(signal.SIGTERM, forward)
    signal.signal(signal.SIGINT, forward)
    details = {'project': project, 'tasks': tasks, 'runId': os.environ.get('DEPENDEASY_OPERATION_RUN_ID')}
    with remote_build.place_in_line(state, details) as ticket:
        remote_build.emit_admission(project, tasks, 'Queued', 'Waiting for local build lease')
        with remote_build.local_lease(state, ticket=ticket):
            remote_build.emit_admission(project, tasks, 'Admitted')
            print('gradle-lease: this process holds the local Gradle lease', file=sys.stderr, flush=True)
            child = subprocess.Popen(command, env=dict(os.environ, REMOTE_DEV_WORKER='1'))
            return child.wait()


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))

