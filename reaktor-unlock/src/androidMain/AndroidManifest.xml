<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Lets the app show the system's fingerprint or face prompt. A normal permission: granted at
        install, never asked for, and it gives the app no fingerprint or face data, only yes or no.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
