include("${CMAKE_CURRENT_LIST_DIR}/reaktor.cmake")

macro(reaktor_platform)
    if(iOS)
        setup_ios()
    endif()
endmacro()

macro(reaktor_configuration)
    if(APPLE)
        enable_language(OBJC OBJCXX)
    endif()
    init()
endmacro()

function(reaktor_library name)
    if(ANDROID)
        add_library(${name} SHARED ${common} ${droid})
    elseif(APPLE)
        add_library(${name} STATIC ${common} ${darwin})
    else()
        add_library(${name} STATIC ${common})
    endif()
    target_include_directories(${name} PUBLIC ${DEPE_NATIVE_INCLUDE_DIRECTORIES})
    target_include_directories(${name} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src/androidMain/cpp" "${CMAKE_CURRENT_SOURCE_DIR}/src/iosMain/cpp")
    target_compile_options(${name} PRIVATE ${DEPE_NATIVE_COMPILE_OPTIONS})
    target_link_options(${name} PRIVATE ${DEPE_NATIVE_LINK_OPTIONS})
    target_link_libraries(${name} PUBLIC ${DEPE_NATIVE_LINK_LIBRARIES})
    if(REAKTOR_INTEROP_EXPORTS_HEADER)
        target_compile_definitions(${name} PRIVATE REAKTOR_INTEROP_EXPORTS_HEADER="${REAKTOR_INTEROP_EXPORTS_HEADER}")
    endif()
endfunction()
