function(init)
    if(NOT CMAKE_BUILD_TYPE)
        set(CMAKE_BUILD_TYPE Release PARENT_SCOPE)
    endif()
    set(CMAKE_EXPORT_COMPILE_COMMANDS ON PARENT_SCOPE)

    if(DEFINED DEPE_TOOLCHAIN_CONTRACT)
        include("${DEPE_TOOLCHAIN_CONTRACT}")
        if(NOT DEPE_TOOLCHAIN_SCHEMA EQUAL 1)
            message(FATAL_ERROR "Unsupported Dependeasy toolchain schema")
        endif()
    elseif(NOT CMAKE_CXX_STANDARD)
        message(FATAL_ERROR "A generated Dependeasy toolchain contract is required")
    endif()
    set(CMAKE_CXX_STANDARD "${CMAKE_CXX_STANDARD}" PARENT_SCOPE)
    set(CMAKE_CXX_EXTENSIONS OFF PARENT_SCOPE)
    if(NOT DEFINED CMAKE_CXX_SCAN_FOR_MODULES)
        set(CMAKE_CXX_SCAN_FOR_MODULES OFF PARENT_SCOPE)
    endif()
    set(CMAKE_CXX_STANDARD_REQUIRED ON PARENT_SCOPE)

    if(NOT DEPE_NATIVE_SCHEMA EQUAL 1 OR NOT DEPE_NATIVE_CONTRACT)
        message(FATAL_ERROR "A generated Dependeasy native contract is required")
    endif()
    set(DEPE_NATIVE_CONFIGURE_TARGETS TRUE)
    include("${DEPE_NATIVE_CONTRACT}")
endfunction()
